# Runtime
NODE_ENV=development
PORT=8080
# Browser origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Monad testnet
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz

# Local services
DATABASE_URL=postgres://fluxpay:fluxpay@localhost:5432/fluxpay
REDIS_URL=redis://localhost:6379

# Contract addresses (fill after deploy; see deployments/)
USDC_ADDRESS=
WMON_ADDRESS=
WETH_ADDRESS=
AUSD_ADDRESS=
KUSDC_ADDRESS=
USERNAME_REGISTRY_ADDRESS=
FLUXPAY_ADDRESS=
LINK_ESCROW_ADDRESS=
STREAM_VAULT_ADDRESS=

# Auth (Privy) - App Secret stays server-side; App ID goes in frontend/.env
PRIVY_APP_SECRET=
# Privy token verification via JWKS (dashboard --- Settings --- JWKS endpoint).
# Backend rejects all protected routes without it.
PRIVY_APP_ID=
PRIVY_JWKS_URL=

# Gasless (Pimlico bundler + paymaster)
PIMLICO_API_KEY=
