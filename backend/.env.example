# Monad testnet
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz

# Local services
DATABASE_URL=postgres://fluxpay:fluxpay@localhost:5432/fluxpay
REDIS_URL=redis://localhost:6379

# Contract addresses (fill after deploy; see deployments/)
USDC_ADDRESS=
USERNAME_REGISTRY_ADDRESS=
FLUXPAY_ADDRESS=
SPLIT_MANAGER_ADDRESS=
LINK_ESCROW_ADDRESS=
STREAM_VAULT_ADDRESS=

# Relayer (never commit real keys)
PRIVATE_KEY=

# Auth (Privy) — App Secret stays server-side; App ID goes in frontend/.env
PRIVY_APP_SECRET=

# Gasless (Pimlico bundler + paymaster)
PIMLICO_API_KEY=

# Indexer (Envio hosted)
ENVIO_API_KEY=

# Portfolio data (Zerion) — called server-side only, never from the browser
ZERION_API_KEY=
